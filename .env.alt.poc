# POC environment — server GPU (L40S 48GB rekomendasi)
# WAJIB: ganti semua CHANGE_ME sebelum deploy
# Salin ke .env: cp .env.alt.poc .env

# LLM 
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=180
LLM_SUPPORTS_VISION=false

# Embedding 
EMBED_PROVIDER=huggingface
EMBED_BASE_URL=
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DEVICE=cuda
EMBED_BATCH_SIZE=32

# Reranker 
RERANKER_PROVIDER=sentence_transformers
RERANKER_BASE_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=6

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=unhas_docs

# Pipeline retrieval
SIMILARITY_TOP_K=12
SCORE_THRESHOLD=0.3
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# Neighbor expansion — fetch chunks tetangga supaya konteks PDF panjang tidak terpotong
NEIGHBOR_EXPANSION_ENABLED=true
NEIGHBOR_EXPANSION_RADIUS=2
MAX_EXPANDED_CHUNKS=30

# Conversation history (multi-turn)
HISTORY_TURNS=5
HISTORY_MAX_TOKENS=1500

# Vision
MAX_IMAGES_PER_MESSAGE=2
MAX_IMAGE_SIZE_MB=10
IMAGE_RESIZE_MAX_DIM=1280

# Storage — MinIO
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=CHANGE_ME
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_BUCKET=ragchat-images

# Redis cache + rate limit
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_SIMILARITY_THRESHOLD=0.97
CACHE_SKIP_IF_HAS_IMAGE=true

# Rate limiting
RATE_LIMIT_TEXT_PER_MINUTE=20

# Circuit breaker
CIRCUIT_OPEN_THRESHOLD=60
CIRCUIT_RECOVERY_THRESHOLD=20

# PostgreSQL
DATABASE_URL=postgresql://ragchat:dev@localhost:5432/ragchat

# Auth — generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Intent Classifier (IndoBERT)
INTENT_MODEL_PATH=models/intent_classifier
INTENT_CONFIDENCE_THRESHOLD=0.6

# Moderation (Layer 2) — Llama Guard 3 via Ollama (URL terpisah dari LLM utama)
MODERATION_BACKEND=passthrough
MODERATION_MODEL=llama-guard3:1b
MODERATION_BASE_URL=http://ollama:11434

# CORS 
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=DEBUG

# Private API (isi saat endpoint UNHAS siap)
UNHAS_API_BASE_URL=

# Postgres container — sinkron dengan password di DATABASE_URL
# POSTGRES_PASSWORD=CHANGE_ME

# MinIO container admin credentials — sinkron dengan MINIO_ACCESS_KEY/SECRET_KEY
# MINIO_USER=CHANGE_ME
# MINIO_PASSWORD=CHANGE_ME

# HuggingFace token — wajib jika pakai model gated (mis. Llama / beberapa varian Qwen)
# Generate di https://huggingface.co/settings/tokens (scope: read)
# Kosongkan jika semua model yang dipakai public
# HF_TOKEN=

# Grafana admin password — untuk akses dashboard di port 3000
# GRAFANA_PASSWORD=CHANGE_ME

# ─── PDF Indexing Configuration ───────────────────────────────────────────
# Strategi extraction: auto | fast | hi_res
# - fast: PyMuPDF + PaddleOCR fallback (text-heavy PDF)
# - hi_res: Unstructured.io layout-aware (PDF rich content dengan tabel/gambar)
# - auto: deteksi otomatis per file berdasarkan kepadatan gambar
PDF_EXTRACTION_STRATEGY=auto

# Extract tabel ke format Markdown (true/false)
PDF_EXTRACT_TABLES=true

# Extract gambar dari PDF (true/false)
PDF_EXTRACT_IMAGES=true

# Deskripsikan gambar via vision LLM: auto | true | false
# Di POC default auto = aktif karena LLM_SUPPORTS_VISION=true (Qwen3-VL)
PDF_DESCRIBE_IMAGES=false

# Skip gambar lebih kecil dari ukuran ini (KB) — biasanya icon/logo
PDF_MIN_IMAGE_SIZE_KB=20

# Max dimensi gambar sebelum dikirim ke vision LLM (resize untuk hemat token)
PDF_MAX_IMAGE_DIM=1280

# Tabel < N char digabung dengan section. > N → chunk independen
PDF_TABLE_MAX_CHARS=2000

# QA evaluation sync to Google Sheets
QA_SYNC_GOOGLE_CREDENTIALS_FILE=/run/secrets/google_service_account.json
QA_SYNC_SPREADSHEET_ID=CHANGE_ME
QA_SYNC_WORKSHEET_NAME=Sheet1
QA_SYNC_INTERVAL_SECONDS=3600 # 1 jam sekali sync