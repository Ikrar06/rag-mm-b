# =============================================================================
# .env.research — harness eksperimen retrieval multimodal
# Server: Ubuntu 24.04 aarch64 | GB10 sm_121 | CUDA 13.2 | Python 3.12.3
#         tanpa sudo, tanpa Docker, mesin dipakai bersama
# =============================================================================
#
# Pakai:
#   cp .env.research .env
#
# Blok "FLAG RISET" di bawah adalah daftar BEKU dari CHANGES.md. Tidak diubah
# lagi setelah eksperimen dimulai; mengubahnya menuntut re-index penuh dan
# membatalkan seluruh anotasi gold yang menunjuk chunk_id atau image_id.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# FLAG RISET — BEKU, salin apa adanya, sama persis dengan peneliti fork lain
# ─────────────────────────────────────────────────────────────────────────────

# Tahap 1 — identitas chunk & pemecahan ganda
INDEX_EXCLUDE_METADATA_FROM_EMBED=true
INDEX_MAX_CHUNK_TOKENS=350
INDEX_MIN_CHUNK_TOKENS=8
INDEX_DISABLE_NODE_PARSER=true

# Tahap 2 — identitas berlapis tiga & metadata struktural
INDEX_STRUCTURAL_METADATA=true
INDEX_TABLES_AS_OWN_CHUNKS=true

# Tahap 4 — gambar
INDEX_PERSIST_IMAGES=true

# Nilai lama yang ikut menentukan isi chunk
CHUNK_SIZE=512
CHUNK_OVERLAP=128
PDF_TABLE_MAX_CHARS=2000

# Naik kepentingannya sejak `section` dikecualikan dari embedding: chunk teks
# kedua dan seterusnya dalam satu section kini tanpa sinyal section di ruang
# vektor, sehingga ekspansi tetangga yang menutupinya.
NEIGHBOR_EXPANSION_ENABLED=true
NEIGHBOR_EXPANSION_RADIUS=2
MAX_EXPANDED_CHUNKS=30

# JANGAN disetel kecuali kamu sadar menerima korpus gambar tidak lengkap.
# Nilainya tercatat di run_manifest.json.
# ALLOW_INCOMPLETE_IMAGE_CORPUS=false


# ─────────────────────────────────────────────────────────────────────────────
# EKSTRAKSI — wajib hi_res, ditegakkan di kode
# ─────────────────────────────────────────────────────────────────────────────
# indexing._check_image_strategy MENOLAK selain "hi_res" saat
# INDEX_PERSIST_IMAGES aktif: jalur `fast` tidak mengekstrak gambar sama sekali,
# dan ketiadaan barisnya di images.jsonl tidak dapat dibedakan dari "dokumen ini
# memang tanpa gambar".
PDF_EXTRACTION_STRATEGY=hi_res

# hi_res memakai tesseract lewat Unstructured, bukan PaddleOCR. OCR_USE_GPU
# tidak relevan karena paddleocr tidak dipasang di server ini; nilai apa pun
# tidak berefek. Disetel false agar tidak menyesatkan pembaca manifest.
OCR_USE_GPU=false

PDF_EXTRACT_TABLES=true
PDF_EXTRACT_IMAGES=true

# Deskripsi gambar butuh endpoint vision. Tanpa Docker, vLLM kemungkinan tidak
# ada di server ini. "auto" berarti aktif hanya bila LLM_SUPPORTS_VISION=true,
# jadi aman dibiarkan: gambar TETAP tersimpan ke disk lewat INDEX_PERSIST_IMAGES
# walau tidak dideskripsikan — narrative_summary-nya null di images.jsonl.
PDF_DESCRIBE_IMAGES=auto
PDF_MIN_IMAGE_SIZE_KB=20
PDF_MAX_IMAGE_DIM=1280


# ─────────────────────────────────────────────────────────────────────────────
# MODEL — semuanya in-process, tidak ada container
# ─────────────────────────────────────────────────────────────────────────────
# TEI berjalan sebagai container dan Docker tidak tersedia. Tag TEI `89-latest`
# juga mengunci compute capability 8.9 — tidak cocok dengan sm_121.
EMBED_PROVIDER=huggingface
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DEVICE=cuda
EMBED_BATCH_SIZE=8

RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=models/bge-reranker-v2-m3

# LLM tidak dipakai jalur indexing, tapi _configure_settings() memanggil
# get_llm() tanpa syarat (rag_pipeline.py:623) sehingga provider harus valid.
# Biarkan ollama walau tidak ada server Ollama: klien hanya dikonstruksi,
# tidak dipanggil, selama PDF_DESCRIBE_IMAGES tidak aktif.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_SUPPORTS_VISION=false

# Nol, bukan 0.1 — determinisme lebih penting daripada variasi untuk eksperimen.
LLM_TEMPERATURE=0


# ─────────────────────────────────────────────────────────────────────────────
# QDRANT — binary aarch64 musl di ~/opt/qdrant, bukan container
# ─────────────────────────────────────────────────────────────────────────────
# Port non-default supaya tidak bentrok dengan instance peneliti lain di mesin
# yang sama. Bind 127.0.0.1 saja. Lihat DEPLOY.md.
QDRANT_URL=http://127.0.0.1:16333

# Versi yang DIHARAPKAN. Dicatat di run_manifest.json bersama versi yang
# benar-benar terdeteksi dari server, sehingga run yang dijalankan sebelum dan
# sesudah Qdrant dipindah port atau di-upgrade dapat dibedakan dari artefaknya
# saja — tanpa perlu mengingat kapan perubahan itu terjadi.
QDRANT_SERVER_VERSION=1.17.1

# ── QDRANT_COLLECTION SENGAJA TIDAK DISETEL DI SINI ──
#
# config.py memanggil load_dotenv(), yang mencari .env RELATIF terhadap
# direktori kerja. Pemisahan collection antar peneliti karenanya bergantung
# pada disiplin operasional, bukan pada berkas ini — dua sesi shell dengan
# direktori kerja berbeda dapat memuat .env berbeda tanpa peringatan, dan
# _ensure_collection punya jalur pemulihan yang MENGHAPUS collection bila
# namanya bertabrakan (indexing.py, cabang "already exists").
#
# Kirim eksplisit di baris perintah SETIAP run:
#
#   QDRANT_COLLECTION=rag_mm_b_varian_c python -m scripts.index_documents
#
# Nilainya tercatat di run_manifest.json, jadi salah kirim tetap terlacak
# setelahnya — tapi lebih baik tidak salah sejak awal.


# ─────────────────────────────────────────────────────────────────────────────
# DIMATIKAN — layanan chatbot, tidak dipakai riset
# ─────────────────────────────────────────────────────────────────────────────
# Llama Guard butuh Ollama; passthrough melewatinya tanpa HTTP call sama sekali.
MODERATION_BACKEND=passthrough

# Cache membuat query berulang tidak menyentuh retrieval sama sekali —
# mematikan pengukuran lapis 1.
CACHE_ENABLED=false

LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
# DUMP — observasi saja, tidak memengaruhi isi chunk
# ─────────────────────────────────────────────────────────────────────────────
# Boleh berbeda antar fork. Direktori ini tumbuh tiap run; awasi kuota disk.
CHUNK_DUMP_DIR=data/dumps

# Registry pemetaan nama berkas -> document_id. WAJIB sama persis dengan
# peneliti fork lain: document_id menentukan chunk_id, image_id, DAN nama
# direktori gambar di disk.
# DOCUMENT_REGISTRY_PATH=data/document_registry.json
