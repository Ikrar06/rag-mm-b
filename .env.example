# =============================================================================
# .env.example — flag riset untuk harness eksperimen retrieval multimodal
# =============================================================================
#
# Berkas ini HANYA memuat flag yang ditambahkan untuk riset (Tahap 1 & Tahap 2).
# Untuk environment lengkap (LLM, embedding, Qdrant, Postgres, dst), salin
# .env.poc atau .env.dev lalu tambahkan blok di bawah ini.
#
# SEMUA flag di bawah default MATI. Tanpa satu pun diset, jalur indexing
# berperilaku persis seperti tag `baseline-riset`.
#
# Verifikasi kapan saja:
#   python scripts/probe_rechunk.py          # baseline: 5/9 bertabrakan
#   <flag di bawah> python scripts/probe_rechunk.py   # riset: 0/9
# =============================================================================


# ─── Tahap 1: identitas chunk & pemecahan ganda ──────────────────────────────

# Hanya `section` yang ikut divektorkan; field provenance lain dikecualikan.
# Terukur: metadata_len 128 -> 14 token, effective_chunk_size 384 -> 498.
#
# PERHATIAN jalur query: SentenceTransformerRerank membaca MetadataMode.EMBED,
# jadi flag ini mengubah teks yang di-rerank saat
# RERANKER_PROVIDER=sentence_transformers (.env.dev, .env.alt.poc).
# Jalur TEI tidak terpengaruh.
INDEX_EXCLUDE_METADATA_FROM_EMBED=true

# Batas token per chunk keluaran _chunk_elements. NILAI DIBEKUKAN UNTUK SELURUH
# EKSPERIMEN — jangan diubah tanpa re-index penuh dan pencatatan di manifest.
#
# Asal angka 350:
#   CHUNK_SIZE                                              512 token
#   - metadata_len terburuk yang direncanakan (16 field)   -132 token
#   = effective_chunk_size terkecil                         380 token
#   350 memberi sisa aman 30 token terhadap batas itu, dan 148 token terhadap
#   effective_chunk_size saat ini (498) bila field masa depan belum terpasang.
#
# Satuannya TOKEN memakai tokenizer yang sama dengan splitter LlamaIndex
# (tiktoken cl100k_base), bukan karakter — supaya batas di sini dan
# effective_chunk_size di sana tidak bisa berselisih.
#
# Rasio terukur teks akademik Indonesia: naratif 3,53 char/token,
# tabel Markdown 2,44 char/token.
INDEX_MAX_CHUNK_TOKENS=350

# Matikan node parser LlamaIndex (transformations=[]) sehingga satu Document
# menjadi tepat satu node. Tanpa ini, tabel besar tetap dipecah dan beberapa
# titik Qdrant berbagi satu chunk_index.
#
# Menutup juga perbedaan dua entry point: POST /api/index memakai Settings
# default (1024/200) karena tidak pernah memanggil _configure_settings,
# sedangkan CLI memakai 512/128.
INDEX_DISABLE_NODE_PARSER=true

# Ambang minimum token; di bawahnya chunk tidak diemisikan. Mengaktifkan juga
# pembuangan chunk yang isinya hanya baris judul section, berapa pun panjangnya.
#
# Asal angka 8: kalimat asli terpendek yang terukur di korpus contoh berukuran
# 8 token ("Pengajuan ditolak."), sedangkan judul berkisar 6-18 token. Panjang
# saja tidak memisahkan keduanya — itulah sebabnya penyaring judul struktural
# diperlukan di samping ambang ini.
INDEX_MIN_CHUNK_TOKENS=8


# ─── Tahap 2: identitas berlapis tiga & metadata struktural ──────────────────

# Aktifkan document_id, chunk_id, text_sha, raw_html, table_format, bbox
# di payload chunk.
#
# WAJIB: data/document_registry.json terisi. Berkas PDF yang tidak terdaftar
# (atau document_id-nya masih kosong) DILEWATI saat indexing dengan error log.
# Buat kerangkanya: python scripts/scaffold_document_registry.py
#
# TIDAK BOLEH aktif sendirian tanpa INDEX_EXCLUDE_METADATA_FROM_EMBED atau
# INDEX_DISABLE_NODE_PARSER — raw_html sebuah tabel bisa mencapai ~987 token
# dan membuat SentenceSplitter melempar ValueError. indexing.py menolak
# kombinasi itu di awal dengan pesan yang menjelaskan.
INDEX_STRUCTURAL_METADATA=true

# Tabel kecil (< PDF_TABLE_MAX_CHARS) jadi chunk mandiri, bukan melebur ke
# prosa sekitarnya. Diperlukan agar tiap tabel punya hubungan 1:1 dengan satu
# chunk beserta raw_html-nya.
#
# PERHATIAN: ini MENGGESER BATAS CHUNK TEKS di sekitar tabel, bukan sekadar
# menambah chunk tabel. Fork lain wajib memakai nilai yang sama.
INDEX_TABLES_AS_OWN_CHUNKS=true

# Lokasi registry. Default: <root>/data/document_registry.json
# DOCUMENT_REGISTRY_PATH=data/document_registry.json


# ─── Nilai yang ikut menentukan hasil, tapi bukan flag baru ──────────────────
# Ketiganya WAJIB dicatat di run_manifest.json karena menentukan isi dan batas
# chunk. PDF_TABLE_MAX_CHARS naik pentingnya sejak Tahap 1: karena tabel tidak
# pernah dipecah, nilainya kini adalah satu-satunya batas atas ukuran chunk.
#
# CHUNK_SIZE=512
# CHUNK_OVERLAP=128
# PDF_TABLE_MAX_CHARS=2000
