# POC environment — L40S 48GB (IOH provision)
# WAJIB: ganti semua CHANGE_ME sebelum deploy
# Salin ke .env: copy .env.poc .env

# LLM via vLLM (L40S, dikelola IOH)
LLM_PROVIDER=vllm
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_BASE_URL=http://vllm:8001
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=180
LLM_SUPPORTS_VISION=true

# Embedding via TEI service (IOH provision)
EMBED_PROVIDER=tei
EMBED_BASE_URL=http://tei-embed:8002
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Reranker via TEI service (IOH provision)
RERANKER_PROVIDER=tei
RERANKER_BASE_URL=http://tei-rerank:8003
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=4

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=unhas_docs

# Pipeline
SIMILARITY_TOP_K=8
SCORE_THRESHOLD=0.3

# Conversation history (multi-turn)
HISTORY_TURNS=5
HISTORY_MAX_TOKENS=1500

# Vision
MAX_IMAGES_PER_MESSAGE=2
MAX_IMAGE_SIZE_MB=10
IMAGE_RESIZE_MAX_DIM=1280

# Storage — MinIO (Anda provision)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=ragchat-images

# Redis cache + rate limit
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_SIMILARITY_THRESHOLD=0.97
CACHE_SKIP_IF_HAS_IMAGE=true

# Rate limiting
RATE_LIMIT_TEXT_PER_MINUTE=8
RATE_LIMIT_VISION_PER_MINUTE=2
RATE_LIMIT_BURST_PER_SECOND=3

# Circuit breaker
CIRCUIT_OPEN_THRESHOLD=60
CIRCUIT_RECOVERY_THRESHOLD=20

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ragchat:CHANGE_ME@postgres:5432/ragchat

# Auth
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256

# Postgres container
POSTGRES_PASSWORD=CHANGE_ME
MINIO_USER=CHANGE_ME
MINIO_PASSWORD=CHANGE_ME
